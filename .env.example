# Kopieren nach .env.local (git ignoriert) für `npm run dev`

# Datenbank aus docker-compose.yml
DATABASE_URL=postgres://rezepte:rezepte@localhost:5434/rezepte

# lokal ohne Zitadel entwickeln (wirkt nur außerhalb von NODE_ENV=production)
AUTH_DEAKTIVIERT=true

# mit Login: Application "Rezepte" in Zitadel (Web, Code Flow, Client Secret Basic),
# Redirect URI ${APP_URL}/auth/callback, Post Logout URI ${APP_URL}/anmelden
# AUTH_ISSUER=https://auth.project101.tech
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# mindestens 32 zufällige Zeichen, verschlüsselt das Session-Cookie: openssl rand -base64 32
AUTH_SECRET=lokal-nur-zum-entwickeln-mindestens-32-zeichen
APP_URL=http://localhost:3000
